menu "DermEdge wristband"

    config DERMEDGE_WINDOW_SECONDS
        int "Window length (s)"
        default 30
        help
            The stress model was trained on 30 s WESAD windows. Each finished window is POSTed
            to the hub's /api/wearable/window; the hub's first 3 calibrate it to the wearer.

    choice DERMEDGE_GSR_SOURCE
        prompt "Skin conductance (GSR) source"
        default DERMEDGE_GSR_SIMULATED
        config DERMEDGE_GSR_SIMULATED
            bool "Simulated (BOOT button toggles calm / stressed)"
        config DERMEDGE_GSR_GROVE
            bool "Grove GSR module on an ADC pin"
    endchoice

    config DERMEDGE_GSR_ADC_CHANNEL
        int "GSR ADC1 channel (6 = GPIO34)"
        depends on DERMEDGE_GSR_GROVE
        default 6
        range 0 7

    choice DERMEDGE_TEMP_SOURCE
        prompt "Skin temperature source"
        default DERMEDGE_TEMP_SIMULATED
        config DERMEDGE_TEMP_SIMULATED
            bool "Simulated (follows the calm / stressed state)"
        config DERMEDGE_TEMP_LM35
            bool "LM35 on an ADC pin"
            help
                LM35 flat side facing you: left pin (+Vs) to 5V/VIN -- it needs at least 4 V, so
                not 3V3 -- middle pin (Vout) to the ADC pin, right pin to GND. Skin reads ~300-350
                mV, well inside the ESP32's input range even with the sensor on 5V.
    endchoice

    config DERMEDGE_TEMP_ADC_CHANNEL
        int "LM35 ADC1 channel (7 = GPIO35)"
        depends on DERMEDGE_TEMP_LM35
        default 7
        range 0 7
        help
            ADC1 only: ADC2 pins stop working while WiFi is on. Must differ from the GSR channel.

    choice DERMEDGE_MOISTURE_SOURCE
        prompt "Skin moisture patch source"
        default DERMEDGE_MOISTURE_SIMULATED
        config DERMEDGE_MOISTURE_SIMULATED
            bool "Simulated (eczema patch ~6% drier than reference)"
        config DERMEDGE_MOISTURE_TOUCH
            bool "ESP32 touch pins as capacitive electrodes"
            help
                A crude stand-in for the Southampton e-textile sensor: one electrode taped over
                the eczema-prone area (T0 = GPIO4), one over healthy skin (T3 = GPIO15). Wetter
                skin adds capacitance and lowers the touch reading.
        config DERMEDGE_MOISTURE_OFF
            bool "No moisture patch"
    endchoice

    config DERMEDGE_STRESS_BUTTON_GPIO
        int "Calm/stressed toggle button GPIO (simulated GSR)"
        default 0
        help
            GPIO0 is the BOOT button on most ESP32 dev boards.

endmenu
